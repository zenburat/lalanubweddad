--------------------------------------------------------------------
-- ACCENT COLOR SYSTEM
--------------------------------------------------------------------
local Accent = { Current = Color3.fromRGB(255,255,255), Target = Color3.fromRGB(255,255,255) }
local AccentListeners = {}
local function OnAccentChanged(fn) table.insert(AccentListeners, fn); fn(Accent.Current) end
local function SetAccent(color) Accent.Target = color end

RunService.RenderStepped:Connect(function(dt)
    if Accent.Current ~= Accent.Target then
        Accent.Current = Accent.Current:Lerp(Accent.Target, math.clamp(dt * 6, 0, 1))
        for _, fn in ipairs(AccentListeners) do fn(Accent.Current) end
    end
end)

