--------------------------------------------------------------------
-- UNIFIED DRAGGABLE (touch + mouse)
--------------------------------------------------------------------
local function MakeDraggable(frame, handle)
    local dragging = false
    local dragStart, startPos, activeInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            activeInput = input
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    activeInput = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input == activeInput
        or input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--------------------------------------------------------------------
-- SLIDER (touch-friendly)
--------------------------------------------------------------------
local function MakeSlider(parent, yPos, labelText, minV, maxV, defaultV, onChange)
    New("TextLabel",{ Text=labelText, Font=Enum.Font.GothamMedium, TextSize=11, TextColor3=THEME.Text, BackgroundTransparency=1,
        Position=UDim2.fromOffset(12,yPos), Size=UDim2.new(0.65,0,0,16), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=5 }).Parent=parent
    local valLbl=New("TextLabel",{ Text=tostring(defaultV), Font=Enum.Font.GothamMedium, TextSize=11, TextColor3=THEME.Text, BackgroundTransparency=1,
        AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-12,0,yPos), Size=UDim2.fromOffset(60,16), TextXAlignment=Enum.TextXAlignment.Right, ZIndex=5 })
    valLbl.Parent=parent
    local track=New("Frame",{ Position=UDim2.fromOffset(12,yPos+19), Size=UDim2.new(1,-24,0,6), BackgroundColor3=THEME.Off, BorderSizePixel=0, ZIndex=5 },{Corner(3)})
    track.Parent=parent
    local hitbox = New("TextButton", {
        Text = "", BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, -14), Size = UDim2.new(1, 0, 0, 34),
        AutoButtonColor = false, ZIndex = 8,
    })
    hitbox.Parent = track

    local ratio0=math.clamp((defaultV-minV)/(maxV-minV),0,1)
    local fill=New("Frame",{Size=UDim2.fromScale(ratio0,1),BackgroundColor3=THEME.On,BorderSizePixel=0,ZIndex=6},{Corner(3)})
    fill.Parent=track
    OnAccentChanged(function(c) fill.BackgroundColor3 = c end)

    local dragging=false
    local function setRatio(r)
        r=math.clamp(r,0,1)
        local v=math.floor(minV+r*(maxV-minV))
        valLbl.Text=tostring(v)
        fill.Size=UDim2.fromScale(r,1)
        onChange(v)
    end

    hitbox.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            setRatio((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then
            setRatio((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X)
        end
    end)
end

