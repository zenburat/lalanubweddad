local function BuildToggle(feature, order)
    local state=feature.default
    local row=New("TextButton",{ Text="", AutoButtonColor=false, LayoutOrder=order,
        Size=UDim2.new(1,-6,0,42), BackgroundColor3=THEME.Row, BorderSizePixel=0, ZIndex=5 },
        {Corner(12),Stroke(THEME.Stroke,1)})

    New("TextLabel",{ Text=feature.name, Font=Enum.Font.GothamMedium, TextSize=13, TextColor3=THEME.Text, BackgroundTransparency=1,
        Position=UDim2.fromOffset(12,5), Size=UDim2.new(0.6,0,0,16), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6 }).Parent=row
    New("TextLabel",{ Text=feature.desc, Font=Enum.Font.Gotham, TextSize=9, TextColor3=THEME.SubText, BackgroundTransparency=1,
        Position=UDim2.fromOffset(12,21), Size=UDim2.new(0.6,0,0,14), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6 }).Parent=row

    local sLbl=New("TextLabel",{ Text="OFF", Font=Enum.Font.Gotham, TextSize=11, TextColor3=THEME.SubText, BackgroundTransparency=1,
        AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-62,0.5,0), Size=UDim2.fromOffset(34,16), TextXAlignment=Enum.TextXAlignment.Right, ZIndex=6 })
    sLbl.Parent=row

    local track=New("Frame",{ AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0),
        Size=UDim2.fromOffset(44,24), BackgroundColor3=THEME.Off, BorderSizePixel=0, ZIndex=6 },{Corner(12)})
    local knob=New("Frame",{ AnchorPoint=Vector2.new(0,0.5), Position=UDim2.fromOffset(3,12),
        Size=UDim2.fromOffset(18,18), BackgroundColor3=THEME.Knob, BorderSizePixel=0, ZIndex=7 },{Corner(9),Stroke(THEME.Stroke,1)})
    knob.Parent=track; track.Parent=row

    local function Render(anim)
        local t=anim and 0.25 or 0
        Tween(track,t,{BackgroundColor3=state and Accent.Current or THEME.Off})
        Tween(knob,t,{Position=state and UDim2.fromOffset(23,12) or UDim2.fromOffset(3,12)},Enum.EasingStyle.Back)
        sLbl.Text=state and "ON" or "OFF"
        Tween(sLbl,t,{TextColor3=state and THEME.Text or THEME.SubText})
    end
    OnAccentChanged(function(c) if state then track.BackgroundColor3 = c end end)

    row.MouseButton1Click:Connect(function()
        state=not state; Render(true); Settings:Set(feature.id,state)
    end)
    row.MouseEnter:Connect(function() Tween(row,0.15,{BackgroundColor3=Color3.fromRGB(30,30,36)}) end)
    row.MouseLeave:Connect(function() Tween(row,0.15,{BackgroundColor3=THEME.Row}) end)
    Render(false)
    row.Parent=fList

    Settings:Connect(feature.id,function(v) if v~=state then state=v; Render(true) end end)
end

